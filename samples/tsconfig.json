{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Node runs these .ts files directly by stripping types, so relative imports
    // name real files (.ts). Nothing is emitted here — these examples only ever run.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    // Rejects enums, namespaces and parameter properties — anything Node can't strip.
    "erasableSyntaxOnly": true,

    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["examples"]
}
