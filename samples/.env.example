# Every example runs against the built-in fake server by default.
# Set this to point the same code at a real llama-server instead.
LLAMA_LIVE=0

# llama-server -m model.gguf -c 8192 --jinja --port 8080
LLAMA_URL=http://127.0.0.1:8080
# LLAMA_API_KEY=            # only if the server was started with --api-key

LLAMA_TEMPERATURE=0.3
LLAMA_MAX_TOKENS=1024
AGENT_MAX_STEPS=8

# Set to 1 when the server runs without --jinja, so the model's chat template
# carries no tool support and calls have to be recovered from plain text.
LOOSE_TOOLS=0

# A second llama-server running an embedding model, for example 08.
# llama-server -m nomic-embed-text-v1.5.gguf --embeddings --port 17118
EMBED_URL=http://127.0.0.1:8081

# One llama-server per model, for example 11 and the eval runner.
# LLAMA_TARGETS=qwen7b=http://127.0.0.1:8080,granite3b=http://127.0.0.1:8081
EVAL_RUNS=1
